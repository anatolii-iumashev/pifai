{
  "name": "pif-bot",
  "version": "1.0.0",
  "description": "ПиФ — эмпатичный психологический чат-бот на основе базы знаний Психология и Философия",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.dev.vars --import tsx src/index.ts",
    "start": "node --env-file=.dev.vars --import tsx src/index.ts",
    "build": "tsx scripts/build-knowledge.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "groq-sdk": "^0.8.0",
    "telegraf": "^4.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
